# Production template. Copy to `.env` on the server. Never commit the filled file.
# Replace every REPLACE_ME value before `APP_ENV=production`.

APP_ENV=production
APP_NAME=Vedas Learning
LOG_LEVEL=INFO
LOG_FORMAT=json

SECRET_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com
EMAIL_VERIFICATION_TTL_SECONDS=86400

POSTGRES_USER=veda
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=veda
DATABASE_URL=postgresql+psycopg://veda:REPLACE_ME_DB_PASSWORD@db:5432/veda
REDIS_URL=redis://redis:6379/0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=veda-audio
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_ENDPOINT_URL=https://audio.example.com
AUDIO_STORE=s3

CONTENT_PATH=/content/rigveda_lessons.json
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

ADMIN_EMAIL=guru-admin@example.com
ADMIN_PASSWORD=REPLACE_ME_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Guru Admin

EVALUATION_ENGINE=none
EVALUATION_ENGINE_VERSION=0
ALIGNMENT_ENGINE=none
ALIGNMENT_ENGINE_VERSION=0
PRONUNCIATION_ENGINE=none
PRONUNCIATION_ENGINE_VERSION=0
EVALUATION_TEST_MODE=false
SANSKRIT_ASR_ENABLED=false
PRONUNCIATION_EVALUATION_ENABLED=false
GOP_ENABLED=false
VEDIC_ACCENT_EVALUATION_ENABLED=false
SVARA_ENGINE=none
SVARA_ENGINE_VERSION=0
EXPOSE_DEV_OTP=false
MAX_UPLOAD_BYTES=15728640
