FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY backend/poc/sushrota/requirements-onnx.txt /tmp/requirements-onnx.txt
RUN pip install --no-cache-dir -r /tmp/requirements-onnx.txt

ENTRYPOINT ["python", "backend/poc/sushrota/transcribe_onnx.py"]
