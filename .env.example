# Local Compose template. Copy to `.env` and keep `.env` uncommitted.
# Do not put production secrets in this file.

APP_ENV=development
APP_NAME=Vedas Learning
LOG_LEVEL=INFO
LOG_FORMAT=text

# Generate a long random value for anything other than local Compose.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_BASE_URL=http://127.0.0.1:8080
EMAIL_VERIFICATION_TTL_SECONDS=86400

POSTGRES_USER=veda
POSTGRES_PASSWORD=veda
POSTGRES_DB=veda
DATABASE_URL=postgresql+psycopg://veda:veda@db:5432/veda
REDIS_URL=redis://redis:6379/0

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@veda-learning.local
SMTP_STARTTLS=false

S3_ENDPOINT_URL=http://minio:9090
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=veda-audio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
AUDIO_STORE=s3

# Host-published ports (change if another stack already uses the defaults).
# Keep loopback by default. For temporary same-Wi-Fi Android testing, set to 0.0.0.0.
HOST_API_BIND_ADDRESS=127.0.0.1
HOST_API_PORT=8000
HOST_DB_PORT=5432
HOST_REDIS_PORT=6379
HOST_S3_PORT=9000
HOST_MAILHOG_SMTP_PORT=1025
HOST_MAILHOG_UI_PORT=8025

CONTENT_PATH=/content/rigveda_lessons.json
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Local development only: include the OTP in the API response for quick testing.
EXPOSE_DEV_OTP=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword1
ADMIN_NAME=Guru Admin

EVALUATION_ENGINE=none
EVALUATION_ENGINE_VERSION=0
ALIGNMENT_ENGINE=none
ALIGNMENT_ENGINE_VERSION=0
PRONUNCIATION_ENGINE=none
PRONUNCIATION_ENGINE_VERSION=0
EVALUATION_TEST_MODE=false
SANSKRIT_ASR_ENABLED=false
PRONUNCIATION_EVALUATION_ENABLED=false
GOP_ENABLED=false
VEDIC_ACCENT_EVALUATION_ENABLED=false
SANSKRIT_ASR_MODEL_DIR=/models/sushrota
SANSKRIT_ALIGNER_MODEL_PATH=/models/vedic-aligner/model.int8.onnx
SANSKRIT_ALIGNER_VOCAB_PATH=/models/vedic-aligner/vocab.json
AUDIO_SAMPLE_RATE=16000
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=/models
MODEL_NUM_THREADS=2
SVARA_ENGINE=none
SVARA_ENGINE_VERSION=0
EVALUATION_FIXTURE_DIR=
MAX_UPLOAD_BYTES=15728640
